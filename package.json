{
  "name": "document-renamer",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon --watch src --ignore uploads --ignore processed src/app.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node --test"
  },
  "dependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "express": "^4.19.2",
    "multer": "^2.0.0",
    "pdf-to-img": "^7.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.4"
  },
  "build": {
    "appId": "com.renamefile.desktop",
    "productName": "Rename File",
    "asar": true,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/sharp/**"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "eng.traineddata",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Rename-File-${version}.${ext}"
    }
  }
}
